{
  "name": "web-solid",
  "version": "0.1.0",
  "description": "Personal site built with SolidJS",
  "engines": {
    "node": ">=24"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && node scripts/verify-theme-css.mjs .output/public",
    "build.types": "tsc --incremental --noEmit",
    "dev": "STAGE_NAME=dev vite dev",
    "dev.debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --force",
    "fmt": "prettier --write .",
    "fmt.check": "prettier --check .",
    "lint": "eslint .",
    "preview": "STAGE_NAME=dev vite preview --open",
    "start": "STAGE_NAME=dev vite preview",
    "pretest": "pnpm run build",
    "test": "pnpm run test.unit && pnpm run test.ssr",
    "test.unit": "vitest run src openapi",
    "test.ssr": "vitest run tests/ssr.spec.ts",
    "predeploy": "pnpm run build",
    "deploy": "./scripts/deploy-s3.sh && ./scripts/deploy-lambda.sh",
    "deploy.dev": "STAGE_NAME=dev pnpm run deploy",
    "deploy.stg": "STAGE_NAME=stg pnpm run deploy",
    "deploy.prod": "STAGE_NAME=prod pnpm run deploy",
    "postdeploy": "./scripts/invalidate.sh",
    "stylelint": "stylelint './src/**/*.scss' './src/**/*.css'",
    "generate:openapi": "openapi-typescript http://dev-www.ikuma.cloud/api/v2/openapi.json -o openapi/schema.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@solidjs/vite-plugin": "3.0.1",
    "@types/node": "24.0.14",
    "@types/three": "^0.184.1",
    "@vitest/eslint-plugin": "^1.6.24",
    "eslint": "^9.37.0",
    "eslint-plugin-solid": "0.14.5",
    "globals": "16.4.0",
    "openapi-typescript": "^7.9.1",
    "prettier": "3.6.2",
    "schema-dts": "^1.1.5",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "5.8",
    "typescript-eslint": "8.65.0",
    "typescript-plugin-css-modules": "latest",
    "vite": "8.1.6",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@elmethis/solid": "0.9.0",
    "@formkit/auto-animate": "^0.10.0",
    "@mdi/js": "^7.4.47",
    "@solid-primitives/i18n": "3.0.0",
    "@solidjs/meta": "2.0.0",
    "@solidjs/router": "2.0.1",
    "@solidjs/web": "2.0.3",
    "filesystem-routing": "0.5.0",
    "fuse.js": "^7.1.0",
    "nitro": "3.0.261103-rc",
    "shiki": "4.3.1",
    "sitemap": "^9.0.0",
    "solid-js": "2.0.3",
    "three": "^0.184.0"
  }
}
